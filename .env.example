# Copiá este archivo a ".env" y completá los valores para desarrollo local.
# En Vercel, estas mismas variables se cargan desde Project Settings > Environment Variables.

SECRET_KEY=cambiar-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Base de datos Postgres (Neon, Supabase, etc). Si se deja vacío, se usa SQLite local.
DATABASE_URL=

# Email (Gmail con contraseña de aplicación: https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Email del dueño del emprendimiento, donde llegan las notificaciones de nuevos pedidos.
OWNER_EMAIL=

# Número de WhatsApp con código de país, sin "+" ni espacios (ej: 5493511234567).
WHATSAPP_NUMBER=5493510000000

# Opcional: si se configura, las imágenes de producto se guardan en Cloudinary
# en vez del disco local (necesario para que persistan en Vercel).
CLOUDINARY_URL=
